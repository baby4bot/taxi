rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// 🔒 Taxi Meter 2026 — กติกา Firestore ฉบับ "ปิดจริง" (ขั้นที่ 3 — ใช้หลังทำ Firebase Auth เสร็จ)
//
// ⛔ ห้ามวางไฟล์นี้ก่อนที่แอปจะล็อกอินผ่าน Firebase Auth ได้จริง
//    ถ้าวางก่อน: `request.auth` ยังเป็น null → แอปจะอ่าน/เขียนไม่ได้เลย (คนขับเข้าแอปไม่ได้)
//
// 📚 ขั้นตอนทำ Auth ครบทุกขั้น → ดู FIREBASE-AUTH.md (แนวทาง C: Custom Token ผ่าน Cloud Functions)
//    ลำดับที่ถูกต้อง: ① App Check (เฟส Monitor) → ② Auth + Cloud Function ล็อกอิน → ③ วางไฟล์นี้
//
// 🧠 หลักคิดของไฟล์นี้
//   • uid ของ Firebase Auth = docId ในคอลเลกชัน users (Cloud Function ตั้งตอน createCustomToken(docId))
//     ⇒ เทียบเจ้าของได้ตรง ๆ ด้วย request.auth.uid == uid ไม่ต้องมีตารางจับคู่
//   • อ่าน/เขียนเอกสารของตัวเอง · แอดมิน/ผู้จัดการเห็นของคนอื่นได้ (อ่านสิทธิ์จาก doc ของตัวเอง)
//   • ประวัติเที่ยวห้ามลบ · ร่องรอยการใช้งานเขียนเพิ่มอย่างเดียว
//
// ⚠️ หน้าเข้าสู่ระบบ "ค้นหา username" ในคอลเลกชัน users — ตอนที่ยังไม่ล็อกอินจะอ่านไม่ได้ตามกติกานี้
//    ⇒ ต้องย้ายการค้นหา/ตรวจรหัสผ่านไปไว้ใน Cloud Function (Admin SDK ข้ามกติกาได้) แล้วคืน custom token
//      ถ้ายังใช้วิธีเดิม (อ่าน users จากฝั่งเว็บ) การล็อกอินจะพังทันทีที่วางไฟล์นี้
//
// ✅ ตรวจก่อน/หลังวาง: `powershell -File tests/security-check.ps1` → ก่อนวางต้องเห็น OPEN,
//    หลังวางต้องเห็น LOCKED ทุกข้อ · ถ้าแอปเข้าไม่ได้ → ย้อนกติกาชุดเดิมทันที (ดู SECURITY.md)
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────── ตัวช่วย ───────────────────────────
    function signedIn() { return request.auth != null; }

    // doc ของผู้ใช้ที่ล็อกอินอยู่ (ใช้ uid เป็น docId ตามแนวทาง C)
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin()   { return signedIn() && me().role == 'Admin'; }
    function isManager() { return signedIn() && me().role == 'Manager'; }
    function isStaff()   { return isAdmin() || isManager(); }

    function maxKeys(n) { return request.resource.data.keys().size() <= n; }
    function strLe(f, n) { return !(f in request.resource.data) || (request.resource.data[f] is string && request.resource.data[f].size() <= n); }
    function numBetween(f, lo, hi) { return !(f in request.resource.data) || (request.resource.data[f] is number && request.resource.data[f] >= lo && request.resource.data[f] <= hi); }
    function listLe(f, n) { return !(f in request.resource.data) || (request.resource.data[f] is list && request.resource.data[f].size() <= n); }
    function mapLe(f, n) { return !(f in request.resource.data) || (request.resource.data[f] is map && request.resource.data[f].keys().size() <= n); }
    function okImages() { return strLe('photoURL', 900000) && strLe('qrCodeURL', 900000) && strLe('profilePic', 900000) && strLe('qrPic', 900000); }

    // 🔁 ฟิลด์ที่แอปเขียนได้หลายรูปแบบ (array ผ่าน SDK · JSON string ผ่าน REST) — ต้องยอมรับทั้งคู่
    function shapeOk(f, maxStr, maxItems) {
      return !(f in request.resource.data) ||
        ((request.resource.data[f] is string && request.resource.data[f].size() <= maxStr) ||
         (request.resource.data[f] is map    && request.resource.data[f].keys().size() <= maxItems) ||
         (request.resource.data[f] is list   && request.resource.data[f].size() <= maxItems));
    }

    // ─────────────────────────── 👤 สมาชิก (users) ───────────────────────────
    // อ่านเอกสารเดียว: เจ้าของ หรือแอดมิน/ผู้จัดการ (หน้า "จัดการผู้ใช้งาน")
    // ⚠️ list (คิวรีทั้งคอลเลกชัน) ห้ามเปิดให้คนขับ — เป็นเหตุผลที่ต้องย้ายการล็อกอินไป Cloud Function
    match /users/{uid} {
      allow get:    if signedIn() && (request.auth.uid == uid || isStaff());
      allow list:   if isStaff();
      allow create: if signedIn() && uid == request.auth.uid && maxKeys(120) && okImages();  // ปกติสมัครผ่าน Cloud Function (ข้ามกติกาได้)
      allow update: if signedIn() && (request.auth.uid == uid || isStaff()) &&
                    maxKeys(120) && okImages() &&
                    strLe('username', 60) && strLe('displayName', 120) && strLe('companyName', 120) &&
                    strLe('phoneNumber', 20) && strLe('plateNo', 20) && strLe('role', 60) &&
                    strLe('password', 300) && strLe('sessionId', 100) && strLe('pinHash', 300) &&
                    strLe('themeMode', 20) && strLe('taxiType', 20) && strLe('tollwayMode', 20) &&
                    shapeOk('menuOrder', 20000, 500) &&
                    mapLe('extraPerms', 120) && mapLe('perms', 120) && shapeOk('custom', 500, 60);
      allow delete: if isAdmin();   // ลบบัญชี = แอดมินเท่านั้น (ย้อนกลับไม่ได้)

      // 📒 ประวัติเที่ยว — เจ้าของเท่านั้น (แอดมินอ่านได้เพื่อช่วยตรวจ) · ห้ามลบจากฝั่งเว็บ
      //    'calib' = ค่าที่ผู้ใช้กรอกเทียบมิเตอร์จริง (เขียนแบบ merge ทีหลัง)
      match /trips/{tripId} {
        allow read:   if signedIn() && (request.auth.uid == uid || isStaff());
        allow create, update: if signedIn() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['startTime', 'endTime', 'destName', 'km', 'trafficSec', 'baseFare', 'surcharges', 'pauses', 'catchUps', 'fare', 'driverUid', 'createdAt', 'calib']) &&
          numBetween('startTime', 1000000000000, 9999999999999) &&
          numBetween('endTime', 1000000000000, 9999999999999) &&
          numBetween('km', 0, 5000) &&
          numBetween('trafficSec', 0, 200000) &&
          numBetween('baseFare', 0, 1000) &&
          numBetween('fare', 0, 200000) &&
          numBetween('createdAt', 1000000000000, 9999999999999) &&
          strLe('destName', 300) && strLe('driverUid', 60) &&
          listLe('surcharges', 200) && listLe('pauses', 200) && listLe('catchUps', 200) &&
          mapLe('calib', 30);
        allow delete: if false;   // 🛡️ ห้ามลบประวัติรายได้
      }

      // 🧾 ประวัติการใช้งานรายคน — เจ้าของ/แอดมินเขียนเพิ่ม · ลบไม่ได้
      match /logs/{logId} {
        allow read:   if signedIn() && (request.auth.uid == uid || isStaff());
        allow create: if signedIn() && (request.auth.uid == uid || isStaff()) &&
          request.resource.data.keys().hasOnly(['action', 'detail', 'timestamp', 'byUid', 'byName', 'targetUid']) &&
          strLe('action', 200) && strLe('detail', 1000) && strLe('byName', 80) &&
          strLe('byUid', 60) && strLe('targetUid', 60) &&
          numBetween('timestamp', 1000000000000, 9999999999999);
        allow update, delete: if false;
      }
    }

    // ─────────────────────── 📜 ประวัติการใช้งานรวมทั้งระบบ ───────────────────────
    match /global_logs/{logId} {
      allow read:   if isStaff();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['action', 'detail', 'timestamp', 'byUid', 'byName', 'targetUid']) &&
        strLe('action', 200) && strLe('detail', 1000) && strLe('byName', 80) &&
        strLe('byUid', 60) && strLe('targetUid', 60);
      allow update, delete: if false;
    }

    // ─────────────────────── 🙋 คำขอสิทธิ์เพิ่ม / แจ้งผลคำขอ ───────────────────────
    // เอกสารนี้แอปเขียนฟิลด์ uid / username / displayName / photoURL / missingIds / missingLabels / status / requestedAt
    match /perm_requests/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || isStaff());
      allow write: if signedIn() && (request.auth.uid == uid || isStaff()) &&
                   maxKeys(40) && strLe('username', 60) && strLe('displayName', 120) && strLe('photoURL', 900000) &&
                   strLe('status', 20) && listLe('perms', 120) && listLe('missingIds', 120) && listLe('missingLabels', 120) &&
                   mapLe('extraPerms', 120) && numBetween('requestedAt', 1000000000000, 9999999999999);
    }
    // เอกสารนี้แอปเขียนฟิลด์ outcome / grantedIds / grantedLabels / at
    match /perm_notices/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || isStaff());
      allow write: if signedIn() && (request.auth.uid == uid || isStaff()) &&
                   maxKeys(40) && listLe('items', 120) && listLe('grantedIds', 120) && listLe('grantedLabels', 120) &&
                   strLe('outcome', 20) && numBetween('at', 1000000000000, 9999999999999);
    }

    // ─────────────────────── 📊 โควตาการใช้งาน (ตัวนับรายวัน) ───────────────────────
    // โครงสร้างจริง: { byName, byUid, "2026-09-15": { read, write, del } } — เพิ่มวันละ 1 คีย์
    match /quota_usage/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isStaff());
      allow create, update: if signedIn() && request.auth.uid == uid &&
        maxKeys(400) && strLe('byName', 80) && strLe('byUid', 60);
      allow delete: if false;
    }

    // ─────────────────────── ⚙️ เอกสารตั้งค่าระบบ ───────────────────────
    // อ่านได้ทุกคนที่ล็อกอิน (แอปต้องใช้เรท/สิทธิ์/เมนู/ข้อความ) · เขียนได้เฉพาะแอดมิน/ผู้จัดการ
    // ยกเว้น settings/changelog → ทุกคนช่วยอัปเดตได้ (แอปเขียนเองหลังล็อกอินทุกครั้ง)
    // ⚠️ รายชื่อ docId ต้องครบเท่าที่แอปเขียน: roles · changelog · toast_messages · app_config · appConfig ·
    //    permission_config · menuOrder · app_texts · loading_screen · ui_prefs · reserved_usernames
    //    (reserved_usernames = “ไอดีต้องห้าม” เขียนโดยแอดมินเท่านั้น — ดูเงื่อนไข isStaff() ด้านล่าง)
    match /settings/{docId} {
      allow read: if signedIn();
      allow create, update: if
        docId in ['roles', 'changelog', 'toast_messages', 'app_config', 'appConfig',
                  'permission_config', 'menuOrder', 'app_texts', 'loading_screen', 'ui_prefs',
                  'reserved_usernames'] &&
        maxKeys(80) &&
        listLe('entries', 600) && mapLe('items', 600) && strLe('image', 900000) &&
        shapeOk('side', 20000, 500) && shapeOk('hub', 40000, 500) &&
        shapeOk('hubCats', 20000, 200) && shapeOk('hubItemCat', 20000, 200) &&
        strLe('list', 4000) && numBetween('selfChange', 0, 999) && (   // settings/reserved_usernames (ไอดีต้องห้าม)
          isStaff() ||
          (docId == 'changelog' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entries', 'syncedHash']))
        );
      allow delete: if false;
    }
    match /system/{docId} {
      allow read: if signedIn();
      allow create, update: if isStaff() && docId == 'service_data' && maxKeys(40) && listLe('categories', 60);
      allow delete: if false;
    }

    // ─────────────────────── 🔗 การผูกบัญชี Google (authLink) ───────────────────────
    // authLink/{googleUid} = { docId, email, linkedAt } — ดัชนี “Google บัญชีนี้เป็นของบัญชีแอปไหน”
    // ⚠️ ต้อง “อนุญาตลบ” ไว้เสมอ — แอปลบตอน ① ปลดลิงก์เอง ② แอดมินลบบัญชี ③ ล้างลิงก์ค้าง
    //    ถ้าห้ามลบ: บัญชีที่ถูกลบจะทิ้งลิงก์ค้าง ⇒ Gmail นั้นสมัคร/ผูกกับบัญชีใหม่ไม่ได้ตลอดกาล
    match /authLink/{uid} {
      allow read: if signedIn();
      // ผูก/แก้: เจ้าของลิงก์ หรือแอดมิน/ผู้จัดการ
      allow create, update: if signedIn() && (isStaff() || request.resource.data.docId == request.auth.uid) &&
        maxKeys(10) && strLe('docId', 60) && strLe('email', 200) &&
        numBetween('linkedAt', 1000000000000, 9999999999999);
      // ลบ: เจ้าของลิงก์ หรือแอดมิน/ผู้จัดการ (ปลดลิงก์ · ลบบัญชี · ล้างลิงก์ค้าง)
      allow delete: if signedIn() && (isStaff() || resource.data.docId == request.auth.uid);
    }

    // ─────────────────────────── 🚫 ที่เหลือทั้งหมด: ปฏิเสธ ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
