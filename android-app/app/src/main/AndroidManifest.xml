<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 🌐 โหลดเว็บแอปจาก GitHub Pages -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 📍 ตำแหน่ง: ขอแบบ "ขณะใช้งาน" ก็พอ เพราะเราใช้ Foreground Service ที่มีป้ายแจ้งบนแถบสถานะ
         ⛔ ไม่ขอ ACCESS_BACKGROUND_LOCATION โดยเจตนา — ไม่จำเป็นเมื่อมี Foreground Service
            และถ้าไม่ขอ จะไม่ติดเงื่อนไขตรวจสอบพิเศษของ Play Store -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 🔋 บริการเบื้องหน้า: เก็บพิกัดต่อแม้ปิดจอ/ล็อกจอ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 🔋 ให้แอปขอ "ยกเว้นการประหยัดแบตเตอรี่" จากผู้ใช้ (หน้าต่างของระบบ)
         ถ้าไม่ยกเว้น ระบบจะเข้า Doze เมื่อจอดับ → หยุดส่งพิกัด ⇒ เวลารถติดเพี้ยน -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 📳 สั่นเมื่อมีข้อความแจ้งเตือน (navigator.vibrate ในเว็บใช้สิทธิ์นี้) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 📦 ให้แอป "ดาวน์โหลดไฟล์ติดตั้งรุ่นใหม่แล้วเปิดหน้าติดตั้งให้เอง" ได้
         · ระบบ Android ยังบังคับให้ผู้ใช้กด "ติดตั้ง" ยืนยันเอง 1 ครั้งเสมอ (ยกเว้นแอปแบบ MDM/เจ้าของเครื่อง)
         · ผู้ใช้ต้องเปิด "ติดตั้งจากแหล่งที่ไม่รู้จัก" ให้แอปนี้ด้วย (แอปมีปุ่มพาไปหน้าตั้งค่านั้น) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- 🔎 มองเห็น “แอปตั้งค่า” ของเครื่อง (Android 11+ ซ่อนไว้โดยค่าเริ่มต้น)
         จำเป็นสำหรับการค้นหาหน้าจอ “ตัวบล็อกอัตโนมัติ (Auto Blocker)” ของ Samsung เพื่อพาผู้ใช้ไปปิดก่อนติดตั้ง APK
         ไม่เห็นรายการนี้ = ค้นไม่เจอ แล้วตกไปใช้ทางสำรอง (Security & privacy) แทน -->
    <queries>
        <package android:name="com.samsung.android.settings" />
        <package android:name="com.android.settings" />
        <intent>
            <action android:name="android.settings.SECURITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🚗 (18 ก.ย. 69) ประตูเข้าแอปบนจอรถ (Android Auto)
             ⚠️ ต้องมี createHostValidator() = ALLOW_ALL_HOSTS_VALIDATOR (ใน TaxiCarAppService)
                ไม่งั้นโฮสต์ของรถจะไม่ยอมเชื่อมกับ APK ที่โหลดเอง
             ⚠️ การจะเห็นแอปในรถ: เปิด Developer mode → “Unknown sources” ในแอป Android Auto บนมือถือ (1 ครั้ง)
             หมวดที่ประกาศ = POI (คน้หาระยะ/จุดหมาย) — เป็นหมวดที่ Car App Library รองรับและไม่จำกัดการใช้งาน -->
        <service
            android:name=".TaxiCarAppService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- 📍 บริการเก็บพิกัดฉากหลัง (ประเภท location → ต้องมีสิทธิ์ FOREGROUND_SERVICE_LOCATION) -->
        <!-- 📍 บริการเก็บพิกัดฉากหลัง — stopWithTask="false" = ผู้ใช้ปัดแอปออกจากรายการล่าสุด
             บริการก็ยังเก็บพิกัดต่อ (คนขับปัดทิ้งบ่อยแต่ยังขับอยู่) -->
        <service
            android:name=".BgLocationService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!-- 📦 ตัวแจกไฟล์ APK ที่ดาวน์โหลดไว้ (แทน FileProvider ของ AndroidX — โปรเจกต์นี้ไม่พึ่งไลบรารีภายนอก)
             exported=false + ให้สิทธิ์อ่านเป็นครั้ง ๆ ตอนเปิดหน้าติดตั้งเท่านั้น (ดู ApkFileProvider.java) -->
        <provider
            android:name=".ApkFileProvider"
            android:authorities="${applicationId}.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- ⏰ ตัวปลุกบริการเก็บพิกัด (ปัดแอปทิ้ง / OEM ฆ่าทิ้ง) — ดูเหตุผลใน BgWakeReceiver.java -->
        <receiver
            android:name=".BgWakeReceiver"
            android:exported="false" />

    </application>

</manifest>
